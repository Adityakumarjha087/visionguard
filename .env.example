# Copy to .env (never commit .env). Every value has a safe local default in docker-compose.yml.

# ---- API (Go) ----
VG_ENV=development
# >= 16 chars, mandatory when VG_ENV=production. Generate with: openssl rand -hex 32
VG_JWT_SECRET=
VG_CORS_ORIGINS=http://localhost:20900,http://127.0.0.1:20900
VG_PUBLIC_URL=http://localhost:20900
VG_AUTO_SEED=true
VG_ACCESS_TTL=15m
VG_REFRESH_TTL=168h
VG_RATE_LIMIT_RPS=30
VG_RATE_LIMIT_BURST=90
VG_AUTH_RATE_LIMIT_PER_MIN=20
VG_MAX_UPLOAD_MB=200
POSTGRES_PASSWORD=visionguard

# ---- Notifications (each channel is disabled while empty) ----
VG_SMTP_HOST=
VG_SMTP_PORT=587
VG_SMTP_USERNAME=
VG_SMTP_PASSWORD=
VG_SMTP_FROM=alerts@visionguard.local
VG_SMTP_TO=
VG_TELEGRAM_BOT_TOKEN=
VG_TELEGRAM_CHAT_ID=

# ---- Inference (Python) ----
VG_LOG_LEVEL=INFO
# fake | anthropic | openai | gemini | ollama
VG_VISION_PROVIDER=fake
# empty = provider default (anthropic: claude-opus-5-5, openai: gpt-4o-mini, gemini: gemini-2.0-flash, ollama: llava)
VG_VISION_MODEL=
VG_ANTHROPIC_API_KEY=
VG_OPENAI_API_KEY=
VG_GEMINI_API_KEY=
VG_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Frontend (baked in at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:20901

# ---- Observability ----
GRAFANA_ADMIN_PASSWORD=visionguard
